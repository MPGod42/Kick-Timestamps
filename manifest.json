{
  "manifest_version": 3,
  "name": "Kick Timestamps",
  "version": "1.1",
  "description": "Helpful extension that remembers the VODs you watched and allows you to resume them later from that timestamp.",
  "author": "MPGod42",
  "icons": {
    "128": "assets/icon.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
    "content_scripts": [
        {
        "matches": ["https://kick.com/*"],
        "js": 
          [
            "scripts/trackVODTime.js",
            "scripts/timestampVisualizer.js"
          ]
        }
    ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://kick.com/*"
  ]
}